{
  "info": {
    "name": "Playmaker FC API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/auth/logout"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"Admin@123\",\n  \"new_password\": \"NewStrongPass1\"\n}"
            },
            "url": "{{base_url}}/auth/change-password"
          }
        }
      ]
    },
    {
      "name": "Players",
      "item": [
        {
          "name": "List / Search Players",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/players?search=aj"
          }
        },
        {
          "name": "Get Player Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/players/1"
          }
        },
        {
          "name": "Create Player (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player_id\": \"PFC001\",\n  \"player_name\": \"Ajay Kumar\",\n  \"date_of_birth\": \"2013-09-10\",\n  \"category_id\": 1,\n  \"school\": \"St. Marys\",\n  \"standard\": \"7th\",\n  \"phone_1\": \"9999999999\",\n  \"pickup_person\": \"Father\"\n}"
            },
            "url": "{{base_url}}/players"
          }
        },
        {
          "name": "Update Player (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_2\": \"8888888888\"\n}"
            },
            "url": "{{base_url}}/players/1"
          }
        },
        {
          "name": "Delete (Deactivate) Player (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/players/1"
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/categories"
          }
        },
        {
          "name": "Create Category (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"U17\"\n}"
            },
            "url": "{{base_url}}/categories"
          }
        }
      ]
    },
    {
      "name": "Coaches (Admin only)",
      "item": [
        {
          "name": "List Coaches",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/coaches"
          }
        },
        {
          "name": "Create Coach",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"coach_prasanna\",\n  \"password\": \"Coach@123\",\n  \"coach_name\": \"Prasanna\",\n  \"category_id\": 1\n}"
            },
            "url": "{{base_url}}/coaches"
          }
        },
        {
          "name": "Reassign Coach Category",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": 2\n}"
            },
            "url": "{{base_url}}/coaches/1"
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Get Attendance for Date+Category",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/attendance?date=2026-09-07&category_id=1"
          }
        },
        {
          "name": "Save Attendance (bulk)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-09-07\",\n  \"category_id\": 1,\n  \"records\": [\n    { \"player_id\": 1, \"status\": \"PRESENT\" },\n    { \"player_id\": 2, \"status\": \"ABSENT\" }\n  ]\n}"
            },
            "url": "{{base_url}}/attendance"
          }
        }
      ]
    },
    {
      "name": "Fees",
      "item": [
        {
          "name": "List Fees for Category+Month",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/fees?category_id=1&month=2026-09"
          }
        },
        {
          "name": "Create/Get Monthly Fee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player_id\": 1,\n  \"month\": \"2026-09\",\n  \"fee_amount\": 1000\n}"
            },
            "url": "{{base_url}}/fees"
          }
        },
        {
          "name": "Add Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500,\n  \"payment_method\": \"UPI\"\n}"
            },
            "url": "{{base_url}}/fees/1/payments"
          }
        },
        {
          "name": "Edit Payment",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 600\n}"
            },
            "url": "{{base_url}}/payments/1"
          }
        },
        {
          "name": "Delete Payment",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/payments/1"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Attendance Report",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/reports/attendance?month=2026-09"
          }
        },
        {
          "name": "Fees Report",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/reports/fees?category_id=1&month=2026-09"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/dashboard"
          }
        }
      ]
    },
    {
      "name": "Birthdays",
      "item": [
        {
          "name": "Active Birthday Reminders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/birthdays"
          }
        }
      ]
    }
  ]
}